{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ioscope.local/contracts/v1/domain.schema.json",
  "title": "IOscope canonical domain definitions",
  "$defs": {
    "Evidence": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "metricId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "sequence",
        "deviceId",
        "metricId"
      ],
      "additionalProperties": false
    },
    "Measurement": {
      "type": "object",
      "properties": {
        "metricId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "enum": [
            "system",
            "workload",
            "process"
          ]
        },
        "unit": {
          "enum": [
            "percent",
            "bytes",
            "bytes/s",
            "ops/s",
            "ms",
            "count",
            "celsius",
            "mhz",
            "watts"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unsupported",
            "temporarily_errored"
          ]
        },
        "provenance": {
          "enum": [
            "measured",
            "derived",
            "simulated",
            "conceptual"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ageMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "windowMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metricId",
        "deviceId",
        "scope",
        "unit",
        "value",
        "status",
        "provenance",
        "source",
        "ageMs",
        "windowMs",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "TelemetryFrame": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "elapsedUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "maxItems": 256
        }
      },
      "required": [
        "schemaVersion",
        "sessionId",
        "runId",
        "origin",
        "sequence",
        "elapsedUs",
        "capturedAt",
        "measurements"
      ],
      "additionalProperties": false
    },
    "DeviceCapabilities": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metricId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "status": {
                "enum": [
                  "available",
                  "unavailable",
                  "unsupported",
                  "temporarily_errored"
                ]
              },
              "requiresElevation": {
                "type": "boolean"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "metricId",
              "status",
              "requiresElevation",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "schemaVersion",
        "deviceId",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HardwareInventory": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "inventoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "platform": {
          "enum": [
            "windows",
            "linux",
            "simulated"
          ]
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "kind": {
                "enum": [
                  "cpu",
                  "ram",
                  "storage",
                  "gpu",
                  "vram",
                  "interconnect",
                  "motherboard"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "metrics": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Measurement"
                },
                "maxItems": 256
              }
            },
            "required": [
              "deviceId",
              "kind",
              "name",
              "metrics"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "schemaVersion",
        "inventoryId",
        "platform",
        "devices"
      ],
      "additionalProperties": false
    },
    "FlowState": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "mappingVersion": {
          "const": "1.0.0"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "elapsedUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pathId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "representation": {
                "const": "aggregated-conceptual"
              },
              "status": {
                "enum": [
                  "active",
                  "idle",
                  "unknown"
                ]
              },
              "activity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "direction": {
                "enum": [
                  "forward",
                  "reverse",
                  "bidirectional"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Evidence"
                },
                "maxItems": 16
              }
            },
            "required": [
              "pathId",
              "from",
              "to",
              "representation",
              "status",
              "activity",
              "direction",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "queue": {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "representation": {
              "const": "aggregated"
            },
            "configuredLimit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedAverage": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "maxItems": 16
            }
          },
          "required": [
            "deviceId",
            "representation",
            "configuredLimit",
            "observedAverage",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "mappingVersion",
        "sequence",
        "elapsedUs",
        "paths",
        "queue"
      ],
      "additionalProperties": false
    },
    "WorkloadDefinition": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "engine": {
          "enum": [
            "diskspd",
            "gpu-pipeline"
          ]
        },
        "readPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "blockBytes": {
          "enum": [
            4096,
            16384,
            65536,
            262144,
            1048576
          ]
        },
        "queueDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "workingSetBytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 4294967296
        },
        "intensity": {
          "enum": [
            "light",
            "moderate",
            "high"
          ]
        },
        "pattern": {
          "enum": [
            "sequential",
            "random"
          ]
        },
        "cacheMode": {
          "enum": [
            "buffered",
            "unbuffered"
          ]
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "warmupSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "schemaVersion",
        "definitionId",
        "engine",
        "readPercent",
        "blockBytes",
        "queueDepth",
        "workingSetBytes",
        "intensity",
        "pattern",
        "cacheMode",
        "durationSeconds",
        "warmupSeconds",
        "cooldownSeconds"
      ],
      "additionalProperties": false
    },
    "WorkloadStatus": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "enum": [
            "validating",
            "preparing",
            "running",
            "stopping",
            "completed",
            "cancelled",
            "aborted",
            "failed",
            "interrupted"
          ]
        },
        "elapsedUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "state",
        "elapsedUs",
        "progress",
        "reason"
      ],
      "additionalProperties": false
    },
    "ExperimentPhase": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "phaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workload": {
          "$ref": "#/$defs/WorkloadDefinition"
        },
        "observe": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 16
        },
        "settleSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "schemaVersion",
        "phaseId",
        "ordinal",
        "purpose",
        "workload",
        "observe",
        "settleSeconds"
      ],
      "additionalProperties": false
    },
    "ExperimentDefinition": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "definitionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "variable": {
          "enum": [
            "queueDepth",
            "blockBytes",
            "cacheMode",
            "accessPass",
            "pipelineStage"
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExperimentPhase"
          },
          "maxItems": 32,
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "definitionId",
        "title",
        "question",
        "concept",
        "variable",
        "hypothesis",
        "phases"
      ],
      "additionalProperties": false
    },
    "AnalyzerEvent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "elapsedUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ruleVersion": {
          "const": "1.0.0"
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "simpleExplanation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 32,
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "elapsedUs",
        "ruleId",
        "ruleVersion",
        "observation",
        "interpretation",
        "confidence",
        "simpleExplanation",
        "evidence"
      ],
      "additionalProperties": false
    },
    "SafetyEvent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "elapsedUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "action": {
          "enum": [
            "admit",
            "warn",
            "throttle",
            "abort",
            "cleanup",
            "cleanup_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 32
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "elapsedUs",
        "ruleId",
        "action",
        "message",
        "evidence"
      ],
      "additionalProperties": false
    },
    "SystemError": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "operation",
        "correlationId",
        "runId",
        "timestamp",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "RunMetadata": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "origin": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "inventory": {
          "$ref": "#/$defs/HardwareInventory"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceCapabilities"
          },
          "maxItems": 32
        },
        "workload": {
          "$ref": "#/$defs/WorkloadDefinition"
        },
        "experimentExecutionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phaseId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048
              },
              "maxItems": 64
            }
          },
          "required": [
            "name",
            "version",
            "sha256",
            "argv"
          ],
          "additionalProperties": false
        },
        "mappingVersion": {
          "const": "1.0.0"
        },
        "analyzerVersion": {
          "const": "1.0.0"
        },
        "simulatorVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
