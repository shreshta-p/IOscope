    "PresentationContext": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "mode": {
          "enum": [
            "LIVE",
            "SIMULATED",
            "RECORDED"
          ]
        },
        "origin": {
          "enum": [
            "live",
            "simulated"
          ]
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "mode",
        "origin",
        "runId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "LIVE"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "live"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SIMULATED"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "simulated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "RECORDED"
              }
            }
          },
          "then": {
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        }
      ]
    },
